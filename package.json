{
  "name": "xss-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- vite dev",
    "build": "dotenv -e .env -- vite build",
    "build:static": "PUBLIC_TARGET=static PUBLIC_BASE_PATH=/xss-app PUBLIC_PRERENDER_ALL=true dotenv -e .env -- vite build",
    "preview": "dotenv -e .env -- vite preview",
    "preview:static": "PUBLIC_TARGET=static PUBLIC_BASE_PATH=/xss-app PUBLIC_PRERENDER_ALL=true dotenv -e .env -- vite preview",
    "serve": "dotenv -e .env -- node build/index.js",
    "serve:static": "caddy run --config ./scripts/static.Caddyfile",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --incremental --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --incremental --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check ./src && eslint ./src",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx src/lib/simulation/kernel/debye.bench.ts",
    "db:start": "docker compose up db",
    "db:push": "drizzle-kit push",
    "db:seed": "dotenv -e .env -- tsx ./scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "e2e": "dotenv -e .env -- playwright test",
    "e2e:static": "playwright test --config playwright.static.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/sveltekit": "^10.65.0",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "idb-keyval": "^6.3.0",
    "mode-watcher": "^1.1.0",
    "papaparse": "^5.5.4",
    "postgres": "^3.4.9",
    "runed": "^0.37.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/svelte": "^1.1.4",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.23.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "^10.5.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/table-core": "^8.21.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@vitest/browser-playwright": "^4.1.10",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "1.0.0-beta.9-e89174b",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^16.5.0",
    "katex": "^0.16.47",
    "matterviz": "^0.3.7",
    "paneforge": "^1.0.2",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rollup-plugin-visualizer": "^6.0.11",
    "shadcn-svelte": "^1.3.0",
    "storybook": "^10.5.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-lucide-preprocess": "^1.5.0",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  }
}
