# =============================================================================
# Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in real values before running the app.
# NEVER commit .env with real credentials — it is gitignored.
# =============================================================================

# --- SvelteKit / Build -------------------------------------------------------

# Build target: "node" for the SSR production server, "static" for the
# backendless client-side build (client-side compute + IndexedDB storage)
PUBLIC_TARGET=node

# Base path when deployed under a sub-path (e.g. "/xss-app" for GitHub Pages)
PUBLIC_BASE_PATH=

# Set to "true" to prerender all pages (used for static builds)
PUBLIC_PRERENDER_ALL=

# Comma-separated list of origins that SvelteKit should trust for CSRF checks
PUBLIC_TRUSTED_ORIGINS="http://localhost:8080,https://exfldadev01.desy.de,https://european-xfel.github.io"

# Comma-separated list of origins allowed by the CORS middleware
ALLOWED_ORIGINS="http://localhost,https://exfldadev01.desy.de,https://european-xfel.github.io"

# Public origin of the node deployment (adapter-node). REQUIRED in production:
# without it, remote command/form POSTs (upload) are rejected with a
# 403 same-origin error. For a local prod run use http://localhost:8000.
ORIGIN=https://exfldadev01.desy.de

# --- Sentry -------------------------------------------------------------------

# Sentry DSN for frontend error reporting (client + server). Leave empty to
# disable Sentry entirely.
PUBLIC_SENTRY_DSN=

# Per-feature toggles. Everything is ON by default when the DSN is set;
# set a variable to "false" to disable that feature.
PUBLIC_SENTRY_TRACES=
PUBLIC_SENTRY_REPLAY=
PUBLIC_SENTRY_PROFILING=
PUBLIC_SENTRY_LOGS=
PUBLIC_SENTRY_METRICS=
PUBLIC_SENTRY_FEEDBACK=

# Auth token/org/project for source-map upload at build time (optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Python parity tooling (optional; no runtime role) ------------------------
# The Debye kernel runs client-side in TypeScript. The Python backend is kept
# ONLY as a parity oracle for tests/codegen (backend/calculator.py) and is not
# needed to build, serve, or run the app — the gRPC serving layer was retired.

# Sentry DSN for the Python backend, if you run it locally. Leave empty to disable.
SENTRY_DSN=

# Sentry environment tag for the backend (read natively by sentry-sdk).
# Defaults to "production"; set to "development" for local backend runs.
# The frontend needs no equivalent — it tags development/production
# automatically from SvelteKit's dev flag.
SENTRY_ENVIRONMENT=

# --- Database (PostgreSQL) ----------------------------------------------------

# PostgreSQL user
DB_USER=postgres

# PostgreSQL password — CHANGE THIS before deploying
DB_PASSWORD=changeme

# PostgreSQL host (use "db" when running inside docker compose)
DB_HOST=localhost

# PostgreSQL database name
DB_NAME=xss-app
