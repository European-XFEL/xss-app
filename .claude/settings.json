{
  "attribution": {
    "commit": ""
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git stash:*)"
    ],
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint)",
      "Bash(pnpm check:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec dotenv:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git notes:*)",
      "Bash(curl -sf http://localhost:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "jq -r '.tool_input.command // \"\"' | grep -Eq '(^| )(--no-verify|-n)( |$)' && { echo 'blocked: --no-verify/-n would bypass the commit-msg hook; commit normally' >&2; exit 2; }; exit 0"
          }
        ]
      }
    ]
  }
}
